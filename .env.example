# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL = '₹'

# Base URL of the standalone mangal-superfoods-backend service (Express + Prisma)
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# When "true", every feature's api/*Api.js module serves its local
# api/*MockData.js fixtures instead of calling mangal-superfoods-backend —
# lets the frontend run standalone with no backend/DB. See src/config/api.js.
NEXT_PUBLIC_USE_MOCK_API=false
